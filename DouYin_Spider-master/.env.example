# 抖音 cookie（主项目接口认证）
DY_COOKIES=''
# 直播弹幕 cookie
DY_LIVE_COOKIES=''
# 登录凭证（扫码登录后由 login_grab_ticket 自动写入，用于私信签名）
DY_TICKET=''
DY_TS_SIGN=''
DY_CLIENT_CERT=''
DY_PRIVATE_KEY=''

# 存储后端：json（默认）| mysql
STORAGE_BACKEND='json'
# MySQL 连接配置（STORAGE_BACKEND=mysql 时生效）
MYSQL_HOST='127.0.0.1'
MYSQL_PORT='3306'
MYSQL_USER='root'
MYSQL_PASSWORD=''
MYSQL_DB='douyin_spider'

# ---------- 火山方舟（LLM）----------
ARK_API_KEY=''
AI_API_KEY=''
AI_API_URL='https://ark.cn-beijing.volces.com/api/v3'
AI_MODEL='doubao-seed-2-0-pro-260215'

# ---------- TTS 语音合成 ----------
# volc（默认）= 火山引擎 · 豆包语音合成大模型 | cosyvoice = 本地 CosyVoice
TTS_PROVIDER='volc'
# ⚠️ 方舟那把 ark- 开头的 key 不能用于语音合成，要另外一把：
#    ① 语音技术控制台 console.volcengine.com/speech → 开通「豆包语音合成大模型」→ API Key
#    ② 方舟 Agent Plan 的「专属 API Key」（并把 VOLC_TTS_ENDPOINT 换成 /plan/ 那条）
#    旧版控制台则填 VOLC_TTS_APP_ID + VOLC_TTS_ACCESS_TOKEN
VOLC_TTS_API_KEY=''
VOLC_TTS_APP_ID=''
VOLC_TTS_ACCESS_TOKEN=''
VOLC_TTS_RESOURCE_ID='seed-tts-2.0'
VOLC_TTS_ENDPOINT='https://openspeech.bytedance.com/api/v3/tts/unidirectional'
VOLC_TTS_EMOTION=''

# 本地 CosyVoice 服务地址（TTS_PROVIDER=cosyvoice 时生效）
COSYVOICE_URL='http://127.0.0.1:50000'
